# ==========================================
# Variables de Entorno - Autolavado Expréss La Estancia
# ==========================================

# 1. Configuración de Persistencia Cloud con Supabase (Opcional pero recomendado para producción)
# Crea tu proyecto gratuito en https://supabase.com
# Copia la Project URL y la anon / service_role key en Configuración > API
SUPABASE_URL=https://tu-proyecto-id.supabase.co
SUPABASE_KEY=tu-clave-anon-o-service-role-aqui

# 2. Configuración de Microservicios (E3)
INGESTA_PORT=8001
WORKER_PORT=8002
MODELOS_PORT=8003
TABLERO_PORT=8501
